<?xml version="1.0" encoding="utf-8"?>
<!-- Observe stock Home windows only; never filter keys or read screen content. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:packageNames="com.google.android.apps.tv.launcherx,com.google.android.tvlauncher"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault"
    android:canRequestFilterKeyEvents="false"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="0"
    android:description="@string/home_service_desc"
    android:summary="@string/home_service_summary" />
