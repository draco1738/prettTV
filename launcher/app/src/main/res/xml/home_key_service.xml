<?xml version="1.0" encoding="utf-8"?>
<!-- Receives only window changes of the stock launcher package (nothing else) and filters key events
     so the Home key can open Rivi. It cannot read window content. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:packageNames="com.google.android.apps.tv.launcherx,com.google.android.tvlauncher"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="0"
    android:description="@string/home_service_desc"
    android:summary="@string/home_service_summary" />
