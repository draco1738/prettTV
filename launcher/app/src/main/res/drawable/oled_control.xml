<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/prett_background" />
            <corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="@color/prett_focus" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/prett_background" />
            <corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="@color/prett_focus" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/prett_background" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="@color/prett_edge" />
        </shape>
    </item>
</selector>
